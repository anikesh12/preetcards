# Server configuration
PORT=3001
NODE_ENV=development

# Base URL used for generating shareable card links
BASE_URL=http://localhost:3001

# Uploads
UPLOAD_DIR=./uploads
MAX_PHOTOS_PER_CARD=6
MAX_FILE_SIZE_MB=5

# Google AdSense (display ads)
# Client ID from your AdSense account, e.g. ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# Ad slot ID for the ad unit placed on the card view page
ADSENSE_SLOT_ID=XXXXXXXXXX

# Rewarded Ads (e.g. Google AdMob / Ad Manager rewarded video units)
# Client/App ID for the rewarded ad provider, e.g. ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
REWARDED_AD_CLIENT_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# Ad unit ID for the specific rewarded ad placement, e.g. ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY

# Tip Jar
# External link (e.g. Buy Me a Coffee / Ko-fi / PayPal.me) shown as a "support us" link
TIP_JAR_URL=https://www.buymeacoffee.com/yourname