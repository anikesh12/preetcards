# Server configuration
PORT=3001
NODE_ENV=development

# SQLite database file path
DATABASE_PATH=./data/cards.db

# Directory where uploaded/processed images are stored
UPLOADS_DIR=./uploads

# Max number of photos allowed per card
MAX_PHOTOS_PER_CARD=6

# Max upload size per image, in bytes (e.g. 5MB)
MAX_FILE_SIZE_BYTES=5242880

# Single shared admin password used to authenticate access to admin-only
# actions (e.g. moderating/deleting cards). There is no per-user account
# system — anyone with this password is treated as an admin.
ADMIN_PASSWORD=changeme