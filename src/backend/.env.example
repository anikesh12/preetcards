# Server configuration
PORT=3001
NODE_ENV=development

# Base URL used when generating shareable card links
BASE_URL=http://localhost:3001

# Admin password required to access protected/admin-only actions
# Change this to a strong, unique value in production
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign/encrypt session cookies (session-based auth)
# Generate a long random string, e.g.: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Directory (relative to backend/) where uploaded/processed images are stored
UPLOADS_DIR=uploads

# Path to the SQLite database file
DATABASE_PATH=./data/cards.db

# Maximum number of photos allowed per card
MAX_PHOTOS_PER_CARD=6

# Maximum upload file size in bytes (e.g. 5MB)
MAX_FILE_SIZE_BYTES=5242880

# Google AdSense (display ads on non-Birthday occasion cards)
# Leave blank to keep ads off -- a neutral placeholder renders instead.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=

# Tip jar link shown on the card confirmation page. Leave blank to hide it.
TIP_JAR_URL=

# Rewarded video ad gate for premium collage templates (e.g. Customized-card).
# Leave blank and premium templates create immediately with no ad gate.
REWARDED_AD_CLIENT_ID=
REWARDED_AD_UNIT_ID=