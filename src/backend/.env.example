# Server configuration
PORT=3001

# Base URL used to generate shareable card links (no trailing slash)
BASE_URL=http://localhost:3001

# Directory (relative to backend/) where uploaded/processed images are stored
UPLOAD_DIR=uploads

# Maximum upload file size in bytes (default: 5MB per file)
MAX_FILE_SIZE=5242880

# Optional: link shown as a "Support Us" tip jar after a card is created
# (Buy Me a Coffee / PayPal.me / UPI link, etc.). Leave unset to hide it entirely.
TIP_JAR_URL=

# Optional: Google AdSense IDs for the ad slot shown on non-Birthday cards.
# Leave unset to show a neutral layout placeholder instead -- useful for
# testing before AdSense approval, which requires the site to already be live.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=